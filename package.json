{
  "name": "kyoto-diplomacy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx apps/server/main.ts",
    "dev:online": "node scripts/dev-online.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "map:import": "tsx packages/map-tools/import.ts",
    "map:download": "tsx packages/map-tools/download.ts",
    "map:validate": "tsx packages/map-tools/validate.ts",
    "audio:generate": "node scripts/generate-placeholder-sfx.mjs",
    "test:browser": "playwright test",
    "build:server": "npm run typecheck",
    "start:server": "node --import tsx apps/server/main.ts",
    "test:production": "node scripts/test-production.mjs"
  },
  "dependencies": {
    "@turf/turf": "^7.3.0",
    "fast-xml-parser": "^5.3.0",
    "polylabel": "^2.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.10.0",
    "@types/polylabel": "^2.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  }
}
