# Local development: leave these blank; Vite proxies to dev:server.
# Public builds (Render frontend Environment):
VITE_PUBLIC_DEPLOYMENT=true
VITE_ONLINE_SERVER_URL=https://YOUR-BACKEND.onrender.com
# Backend Environment only (never prefix with VITE_):
NODE_ENV=production
FRONTEND_ORIGIN=https://YOUR-FRONTEND.onrender.com
# Render supplies PORT automatically. Do not paste tokens or keys here.
